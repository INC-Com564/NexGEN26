                        "key_type": "key_bind",
                        "needs_empty_hand": false,
                        "allow_scrolling_when_crouching": true,
                        "key": "key.keyboard.j"
                    }
                ],
                "unlocking": []
            }
        },
        "zombie_rage": {
            "type": "palladium:command",
            "icon": "minecraft:iron_sword",
            "title": "Zombie Rage",
            "bar_color": "green",
            "list_index": 4,
            "description": "Gain brute-force zombie strength and toughness for a short time.",
            "commands": [
                "effect give @s minecraft:strength 8 1 true",
                "effect give @s minecraft:resistance 8 0 true",
                "effect give @s minecraft:speed 8 0 true",
                "playsound minecraft:entity.zombie.ambient player @s ~ ~ ~ 0.8 0.9"
            ],
            "conditions": {
                "enabling": [
