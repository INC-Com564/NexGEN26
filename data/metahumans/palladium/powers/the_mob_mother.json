                        "key": "key.keyboard.r"
                    }
                ],
                "unlocking": []
            }
        },
        "night_vision_passive": {
            "type": "palladium:command",
            "icon": "minecraft:spider_eye",
            "title": "Mob Senses",
            "bar_color": "green",
            "list_index": 5,
            "hidden": true,
            "hidden_in_bar": true,
            "description": "Passive senses copied from nocturnal mobs.",
            "commands": [
                "effect give @s minecraft:night_vision 3 0 true"
